# OpenAI API キー（AI 読解・仕様書 Q&A・設計レビュー・メール文案に使用）
# このファイルを .env という名前でコピーし、キーを設定してください。.env は Git 等で共有しないでください。
OPENAI_API_KEY=sk-...

# --- Docker で起動する場合（任意。未指定なら既定値） ---
# APP_PORT=8088            # 画面を開くポート → http://localhost:8088
# POSTGRES_PASSWORD=panel  # 本番では必ず変更する
# WORKERS=1                # API のプロセス数（増やしても、同じ案件の同時更新はデータベースで検知する）

# --- Docker を使わずに起動し、データベースだけ Docker の PostgreSQL を使う場合 ---
# DATABASE_URL=postgresql://panel:panel@127.0.0.1:5434/panel
# （未指定なら backend/data/projects に JSON ファイルで保存）
